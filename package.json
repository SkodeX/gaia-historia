{
  "name": "gaia-historia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interaktive Erdgeschichte im Browser: 3D-Globus mit Zeitregler von der Entstehung der Erde bis heute.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "pwa-assets-generator",
    "plates": "node scripts/build-plates.mjs",
    "data": "npm run plates && npm run fossils && npm run species && npm run silhouettes",
    "fossils": "node scripts/build-fossils.mjs",
    "silhouettes": "node scripts/build-silhouettes.mjs",
    "species": "node scripts/build-species.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "d3-geo": "^3.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
